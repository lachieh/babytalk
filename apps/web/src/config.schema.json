{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiUrl": {
      "type": "string",
      "format": "uri",
      "description": "Public URL of the GraphQL API"
    },
    "sourceUrl": {
      "description": "Source code link shown on the homepage (hidden if unset)",
      "type": "string",
      "format": "uri"
    },
    "tamboApiKey": {
      "default": "",
      "type": "string"
    },
    "tamboUrl": {
      "type": "string",
      "format": "uri",
      "description": "Tambo API URL"
    }
  },
  "required": [
    "apiUrl",
    "tamboUrl"
  ]
}
