{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "databaseUrl": {
      "type": "string",
      "description": "PostgreSQL connection string"
    },
    "jwtSecret": {
      "type": "string",
      "minLength": 16,
      "description": "Secret key for signing JWTs"
    },
    "port": {
      "default": 4000,
      "description": "HTTP server port",
      "type": "number"
    },
    "rpName": {
      "default": "Bubsie",
      "description": "Relying Party display name shown by passkey prompts",
      "type": "string"
    },
    "smtpFrom": {
      "type": "string",
      "minLength": 1,
      "description": "Sender email address, e.g. noreply@example.com"
    },
    "smtpHost": {
      "type": "string",
      "minLength": 1,
      "description": "SMTP server hostname"
    },
    "smtpPass": {
      "default": "",
      "description": "SMTP password (Resend API key for smtp.resend.com)",
      "type": "string"
    },
    "smtpPort": {
      "default": 1025,
      "description": "SMTP server port",
      "type": "number"
    },
    "smtpUser": {
      "default": "",
      "description": "SMTP username ('resend' for smtp.resend.com)",
      "type": "string"
    },
    "webUrl": {
      "type": "string",
      "format": "uri",
      "description": "Public URL of the web app, used for CORS, passkeys, and email links"
    }
  },
  "required": [
    "databaseUrl",
    "jwtSecret",
    "smtpFrom",
    "smtpHost",
    "webUrl"
  ]
}
